# To run from $BUILDDIR/

cd ..
PCCLDIR=`basename $PWD`

echo "Checking for unclean directory ..."
git clean -x -i
echo "Clean done."
echo "Checking for uncommitted files ..."
if [ "`git status -s | wc -l`" != "0" ]; then
  git status -s
  echo "Some changes are not committed yet. Continue ? (Ctrl-C to abort)"
  read
fi

cd ..
PCCL_MAJOR=${pccl:Major}
PCCL_MINOR=${pccl:Minor}
PCCL_PATCH=${pccl:Patch}
PCCL_SUFFIX=${pccl:Suffix}
PCCL_BUILD=${pkg:Revision}

PCCLNAME="pccl-src_${PCCL_MAJOR}.${PCCL_MINOR}.${PCCL_PATCH}${PCCL_SUFFIX}-${PCCL_BUILD}"

tar --exclude build \
    --exclude ".git*" \
    --exclude pkg/srctxz \
    --transform "s/^$PCCLDIR/$PCCLNAME/" -Jcf $PCCLNAME.txz --owner=0 --group=0 $PCCLDIR
