# To run from $BUILDDIR/

BUILDDIR=`basename $PWD`

cd ..
PCCL_MAJOR=${pccl:Major}
PCCL_MINOR=${pccl:Minor}
PCCL_PATCH=${pccl:Patch}
PCCL_SUFFIX=${pccl:Suffix}
HGGC_MAJOR=${hggc:Major}
HGGC_MINOR=${hggc:Minor}
PKG_REVISION=${pkg:Revision}
PKG_ARCH=${pkg:Arch}

PCCLNAME="pccl_${PCCL_MAJOR}.${PCCL_MINOR}.${PCCL_PATCH}${PCCL_SUFFIX}-${PKG_REVISION}+hggc${HGGC_MAJOR}.${HGGC_MINOR}_${PKG_ARCH}"

tar --transform "s/^$BUILDDIR/$PCCLNAME/" -Jcf $PCCLNAME.txz --owner=0 --group=0 $BUILDDIR/bin $BUILDDIR/include $BUILDDIR/lib $BUILDDIR/*.txt
