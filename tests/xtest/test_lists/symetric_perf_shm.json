{
  "schema_version": 2,
  "family": "symetric_perf_shm",
  "defaults": {
    "check": "exit_code",
    "case_name": "test_op_symmetric_{operation_name}_{dtype}_perf_ranks_{ranks}_nnodes{nodes}"
  },
  "axes": {
    "operation": ["all_gather_perf", "all_reduce_perf", "reduce_scatter_perf"],
    "dtype": ["bf16", "f8e4m3", "f8e5m2", "float", "half"]
  },
  "layouts": {
    "single": [
      {"name": "ranks_2", "values": {"ranks": 2, "npernode": 2}},
      {"name": "ranks_4", "values": {"ranks": 4, "npernode": 4}},
      {"name": "ranks_8", "values": {"ranks": 8, "npernode": 8}}
    ],
    "multi": [
      {"name": "ranks_16", "nodes": 2, "values": {"ranks": 16, "npernode": 8}},
      {"name": "ranks_32", "nodes": 4, "values": {"ranks": 32, "npernode": 8}},
      {"name": "ranks_64", "nodes": 8, "values": {"ranks": 64, "npernode": 8}}
    ]
  },
  "bindings": {
    "1": {"plan": "pccl_shm_symetric_perf_single_node1_plan", "suite": "symetric_perf_shm_single_node_suite"},
    "2": {"plan": "pccl_shm_symetric_perf_multi_node2_plan", "suite": "symetric_perf_shm_multi_nodes2_suite"},
    "4": {"plan": "pccl_shm_symetric_perf_multi_node4_plan", "suite": "symetric_perf_shm_multi_nodes4_suite"},
    "8": {"plan": "pccl_shm_symetric_perf_multi_node8_plan", "suite": "symetric_perf_shm_multi_nodes8_suite"}
  },
  "groups": [
    {
      "name": "single", "nodes": [1], "layout_set": "single", "axes": ["operation", "dtype"],
      "command": "mpirun --allow-run-as-root -np {ranks} -npernode {npernode} -mca btl_tcp_if_include {mpi_interface} -mca btl ^openib -mca btl_openib_warn_no_device_params_found 0 {operation} -t 1 -g 1 -d {dtype} -b 8 -e 16G -f 2 -n 20 -w 5 --elapsed_type 1 -R 2"
    },
    {
      "name": "multi", "nodes": [2, 4, 8], "layout_set": "multi", "axes": ["operation", "dtype"],
      "command": "mpirun --allow-run-as-root -np {ranks} -npernode {npernode} -mca btl_tcp_if_include {mpi_interface} -mca btl ^openib -mca btl_openib_warn_no_device_params_found 0 -x NCCL_IB_DISABLE=1 -x PCCL_ENABLE_EXT_KERNEL=0  -x NCCL_MNNVL_ENABLE=1  -x NCCL_MNNVL_UUID=6  -x NCCL_MNNVL_CLIQUE_ID=0  -x PCCL_MNNVL_FAKE_ADVANCED_FEATURE=1 -x PATH={path} -x LD_LIBRARY_PATH={ld_library_path} --hostfile {hostfile} {operation} -t 1 -g 1 -d {dtype} -b 8 -e 16G -f 2 -n 20 -w 5 --elapsed_type 1 -R 2"
    }
  ],
  "profiles": {
    "full": {},
    "smoke": {"nodes": [1], "filters": {"operation": ["all_gather_perf"], "dtype": ["bf16"], "ranks": [2]}}
  }
}
