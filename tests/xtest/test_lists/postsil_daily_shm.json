      "axes": ["operation", "algorithm", "protocol", "dtype", "size", "iters"], "layout_set": "standard",
      "select": {
        "operation": ["all_gather_perf", "broadcast_perf"], "algorithm": ["Ring"],
        "protocol": ["LL", "LL128", "Simple"], "dtype": ["int8"],
        "size": ["32MB", "100.5MB", "512MB", "1.2GB"], "iters": [10]
      },
      "command": "{python_env}/bin/python3.11 run_test.py --op {operation} --algo {algorithm} --proto {protocol} --data-type {dtype} --data-size {size} --iters {iters} --ranks {ranks} {options} --auto-detect"
    },
    {
      "name": "simple_int8", "nodes": [1],
      "axes": ["operation", "algorithm", "protocol", "dtype", "size", "iters"], "layout_set": "standard",
      "select": {
        "operation": ["alltoall_perf", "gather_perf", "hypercube_perf", "scatter_perf", "sendrecv_perf"],
        "algorithm": ["Ring"], "protocol": ["Simple"], "dtype": ["int8"],
        "size": ["32MB", "100.5MB", "512MB", "1.2GB"], "iters": [10]
      },
      "command": "{python_env}/bin/python3.11 run_test.py --op {operation} --algo {algorithm} --proto {protocol} --data-type {dtype} --data-size {size} --iters {iters} --ranks {ranks} {options} --auto-detect"
    },
    {
      "name": "auto", "nodes": [1],
      "axes": ["operation", "algorithm", "protocol", "dtype", "size", "iters"], "layout_set": "standard",
      "select": {
        "operation": ["all_reduce_perf"], "algorithm": ["Auto"], "protocol": ["Auto"], "dtype": ["float"],
        "size": ["27530240", "524304"], "iters": [2]
      },
      "command": "{python_env}/bin/python3.11 run_test.py --op {operation} --algo {algorithm} --proto {protocol} --data-type {dtype} --data-size {size} --iters {iters} --ranks {ranks} {options} --auto-detect"
