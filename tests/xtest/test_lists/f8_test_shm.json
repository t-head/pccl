  },
  "axes": {
    "operation": ["all_gather_perf", "all_reduce_perf", "alltoall_perf", "gather_perf", "hypercube_perf",
                  "reduce_scatter_perf", "scatter_perf", "sendrecv_perf"],
    "algorithm": ["Ring", "Tree"],
    "protocol": ["LL128", "LL", "Simple", "SimpleBulk"],
    "dtype": ["f8e4m3", "f8e5m2"],
    "size": ["1229MB", "512MB", "32MB", "102912KB"],
    "iters": [10]
