                 "dtype": ["f8e4m3", "f8e5m2"], "size": ["102912KB"], "iters": [10]}
    },
    {
      "name": "sendrecv", "nodes": [1], "layout_set": "all", "layouts": ["devices_0_1_4_5"],
      "axes": ["operation", "algorithm", "protocol", "dtype", "size", "iters"],
      "select": {"operation": ["sendrecv_perf"], "algorithm": ["Ring"], "protocol": ["SimpleBulk"],
                 "dtype": ["f8e4m3", "f8e5m2"], "size": ["512MB"], "iters": [10]}
