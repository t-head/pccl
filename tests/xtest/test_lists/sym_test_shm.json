{
  "schema_version": 2,
  "family": "sym_test_shm",
  "defaults": {
    "check": "exit_code",
    "case_name": "test_op_{operation}_algo_SYM_proto_{protocol}_datatype_{dtype}_datasize_{size}_iters_{iters}_ranks_{ranks}_{layout}"
  },
  "axes": {
    "operation": ["all_gather_perf", "all_reduce_perf", "reduce_scatter_perf", "reduce_perf"],
    "protocol": ["LDST", "LL"],
    "dtype": ["bf16", "float"],
    "size": ["1020B", "102912KB", "1GB", "32MB", "512MB"],
