      "command": "python3 run_test.py --op {operation} --data-type {dtype} --data-size {size} --iters {iters} --ranks {ranks} --nproc {nproc} {options} --auto-detect --register 2 --mpi-option '-x NCCL_WIN_ENABLE=1 -x NCCL_SYM_KERNEL=AllGather_ST'"
