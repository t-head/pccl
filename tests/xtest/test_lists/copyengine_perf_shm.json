{
  "schema_version": 2,
  "family": "copyengine_perf_shm",
  "defaults": {
    "check": "exit_code",
    "case_name": "test_op_copyengine_{operation_name}{suffix}_perf_ranks_{ranks}_nnodes{nodes}"
  },
  "axes": {
    "operation": ["all_gather_perf", "all_reduce_perf", "alltoall_perf", "gather_perf",
                  "reduce_scatter_perf", "scatter_perf"],
    "suffix": ["_ar", "_rs", ""]
  },
  "layouts": {
    "single": [
      {"name": "ranks_2", "values": {"ranks": 2, "npernode": 2}},
      {"name": "ranks_4", "values": {"ranks": 4, "npernode": 4}},
      {"name": "ranks_8", "values": {"ranks": 8, "npernode": 8}}
    ],
    "multi": [
      {"name": "ranks_16", "nodes": 2, "values": {"ranks": 16, "npernode": 8}},
      {"name": "ranks_32", "nodes": 4, "values": {"ranks": 32, "npernode": 8}},
      {"name": "ranks_64", "nodes": 8, "values": {"ranks": 64, "npernode": 8}}
    ]
  },
  "bindings": {
    "1": {"plan": "pccl_shm_copyengine_perf_single_node1_plan", "suite": "copyengine_perf_shm_single_node_suite"},
    "2": {"plan": "pccl_shm_copyengine_perf_multi_node2_plan", "suite": "copyengine_perf_shm_multi_nodes2_suite"},
    "4": {"plan": "pccl_shm_copyengine_perf_multi_node4_plan", "suite": "copyengine_perf_shm_multi_nodes4_suite"},
    "8": {"plan": "pccl_shm_copyengine_perf_multi_node8_plan", "suite": "copyengine_perf_shm_multi_nodes8_suite"}
  },
  "groups": [
    {
      "name": "single_gather_ar", "nodes": [1], "layout_set": "single",
      "axes": ["operation", "suffix"],
      "select": {"operation": ["all_gather_perf"], "suffix": ["_ar"]},
      "command": "mpirun --allow-run-as-root -np {ranks} -npernode {npernode} -mca btl_tcp_if_include {mpi_interface} -mca btl ^openib -mca btl_openib_warn_no_device_params_found 0 -x PCCL_CE_ENABLE_AR=1 {operation} -b 32 -e 16G -f 2 -R 2 --elapsed_type 1 -x 2"
    },
    {
      "name": "single_gather", "nodes": [1], "layout_set": "single",
      "axes": ["operation", "suffix"],
      "select": {"operation": ["all_gather_perf"], "suffix": [""]},
      "command": "mpirun --allow-run-as-root -np {ranks} -npernode {npernode} -mca btl_tcp_if_include {mpi_interface} -mca btl ^openib -mca btl_openib_warn_no_device_params_found 0 {operation} -b 32 -e 16G -f 2 -R 2 --elapsed_type 1 -x 2"
    },
    {
      "name": "single_reduce_ar", "nodes": [1], "layout_set": "single",
      "axes": ["operation", "suffix"],
      "select": {"operation": ["all_reduce_perf"], "suffix": ["_ar"]},
      "command": "mpirun --allow-run-as-root -np {ranks} -npernode {npernode} -mca btl_tcp_if_include {mpi_interface} -mca btl ^openib -mca btl_openib_warn_no_device_params_found 0 -x PCCL_CE_ENABLE_AR=1 {operation} -b 32 -e 16G -f 2 -R 2 --elapsed_type 1 -x 2"
    },
    {
      "name": "single_alltoall", "nodes": [1], "layout_set": "single",
      "axes": ["operation", "suffix"],
      "select": {"operation": ["alltoall_perf"], "suffix": [""]},
      "command": "mpirun --allow-run-as-root -np {ranks} -npernode {npernode} -mca btl_tcp_if_include {mpi_interface} -mca btl ^openib -mca btl_openib_warn_no_device_params_found 0 {operation} -b 32 -e 16G -f 2 -R 2 --elapsed_type 1 -x 2"
    },
    {
      "name": "single_gather_plain", "nodes": [1], "layout_set": "single",
      "axes": ["operation", "suffix"],
      "select": {"operation": ["gather_perf"], "suffix": [""]},
      "command": "mpirun --allow-run-as-root -np {ranks} -npernode {npernode} -mca btl_tcp_if_include {mpi_interface} -mca btl ^openib -mca btl_openib_warn_no_device_params_found 0 {operation} -b 32 -e 16G -f 2 -R 2 --elapsed_type 1 -x 2"
    },
    {
      "name": "single_reduce_scatter_rs", "nodes": [1], "layout_set": "single",
      "axes": ["operation", "suffix"],
      "select": {"operation": ["reduce_scatter_perf"], "suffix": ["_rs"]},
      "command": "mpirun --allow-run-as-root -np {ranks} -npernode {npernode} -mca btl_tcp_if_include {mpi_interface} -mca btl ^openib -mca btl_openib_warn_no_device_params_found 0 -x PCCL_CE_ENABLE_RS=1 {operation}  -b 8 -e 16G -f 2 -R 2 --elapsed_type 1 -x 2"
    },
    {
      "name": "single_scatter", "nodes": [1], "layout_set": "single",
      "axes": ["operation", "suffix"],
      "select": {"operation": ["scatter_perf"], "suffix": [""]},
      "command": "mpirun --allow-run-as-root -np {ranks} -npernode {npernode} -mca btl_tcp_if_include {mpi_interface} -mca btl ^openib -mca btl_openib_warn_no_device_params_found 0 {operation} -b 32 -e 16G -f 2 -R 2 --elapsed_type 1 -x 2"
    },
    {
      "name": "multi", "nodes": [2, 4, 8], "layout_set": "multi",
      "axes": ["operation", "suffix"],
      "select": {"operation": ["all_gather_perf", "alltoall_perf", "gather_perf", "scatter_perf"], "suffix": [""]},
      "command_by_nodes": {
        "2": "mpirun --allow-run-as-root -np {ranks} -npernode {npernode} -x PATH={path} -x LD_LIBRARY_PATH={ld_library_path} --hostfile {hostfile} -mca btl_tcp_if_include {mpi_interface} -x NCCL_IB_DISABLE=1 -x NCCL_DEBUG=INFO -x NCCL_MNNVL_ENABLE=1 -x NCCL_MNNVL_UUID=666 -x NCCL_MNNVL_CLIQUE_ID=0 -x PCCL_MNNVL_FAKE_ADVANCED_FEATURE=1 {operation} -b 8 -e 2G -f 2 -R 2 --elapsed_type 1 -x 2",
        "4": "mpirun --allow-run-as-root -np {ranks} -npernode {npernode} -x PATH={path} -x LD_LIBRARY_PATH={ld_library_path} --hostfile {hostfile} -mca btl_tcp_if_include {mpi_interface} -x NCCL_IB_DISABLE=1 -x NCCL_DEBUG=INFO -x NCCL_ALGO=Ring -x NCCL_MNNVL_ENABLE=1 -x NCCL_MNNVL_UUID=666 -x NCCL_MNNVL_CLIQUE_ID=0 -x PCCL_MNNVL_FAKE_ADVANCED_FEATURE=1 {operation} -b 8 -e 2G -f 2 -R 2 --elapsed_type 1 -x 2",
        "8": "mpirun --allow-run-as-root -np {ranks} -npernode {npernode} -x PATH={path} -x LD_LIBRARY_PATH={ld_library_path} --hostfile {hostfile} -mca btl_tcp_if_include {mpi_interface} -x NCCL_IB_DISABLE=1 -x NCCL_DEBUG=INFO -x NCCL_ALGO=Ring -x NCCL_MNNVL_ENABLE=1 -x NCCL_MNNVL_UUID=666 -x NCCL_MNNVL_CLIQUE_ID=0 -x PCCL_MNNVL_FAKE_ADVANCED_FEATURE=1 {operation} -b 8 -e 2G -f 2 -R 2 --elapsed_type 1 -x 2"
      }
    }
  ],
  "profiles": {
    "full": {},
    "smoke": {"nodes": [1], "filters": {"operation": ["all_gather_perf"], "suffix": ["_ar"], "ranks": [2]}}
  }
}
