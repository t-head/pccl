pcclResult_t  pcclParamBind(pcclParamHandle_t** out, const char* key);
pcclResult_t  pcclParamGetI8 (pcclParamHandle_t* h, int8_t*   out);
pcclResult_t  pcclParamGetI16(pcclParamHandle_t* h, int16_t*  out);
pcclResult_t  pcclParamGetI32(pcclParamHandle_t* h, int32_t*  out);
pcclResult_t  pcclParamGetI64(pcclParamHandle_t* h, int64_t*  out);
pcclResult_t  pcclParamGetU8 (pcclParamHandle_t* h, uint8_t*  out);
pcclResult_t  pcclParamGetU16(pcclParamHandle_t* h, uint16_t* out);
pcclResult_t  pcclParamGetU32(pcclParamHandle_t* h, uint32_t* out);
pcclResult_t  pcclParamGetU64(pcclParamHandle_t* h, uint64_t* out);
pcclResult_t  pcclParamGetStr(pcclParamHandle_t* h, const char** out);
pcclResult_t  pcclParamGet(pcclParamHandle_t* h, void* out, int maxLen, int* len);
pcclResult_t  pcclParamGetParameter(const char* key, const char** value, int* valueLen);
pcclResult_t  pcclParamGetAllParameterKeys(const char*** table, int* tableLen);
void  pcclParamDumpAll(void);

